# Variables for docker-compose.yml — copy to .env, then fill in every empty secret.
# (Local development without Docker uses backend/.env instead.)
#
# The secrets are empty on purpose: `docker compose up` stops until each one is set, and the
# backend (NODE_ENV=production) refuses example or weak values. Generate each one with
#   openssl rand -hex 32
# and never reuse a value for two variables. Minimum: 32 characters for keys and tokens,
# 12 for passwords.

POSTGRES_USER=meliora
# Applied when the database volume is created: set it before the first `docker compose up`.
# To change it later, set the new value in Postgres first:
#   docker compose exec postgres psql -U meliora -d postgres -c '\password meliora'
POSTGRES_PASSWORD=

# Message bus: redis (default) or nats (+ `--profile nats`) for several replicas per service.
BUS_TRANSPORT=redis
# Required: Redis only accepts clients that send it.
REDIS_PASSWORD=
# Required with BUS_TRANSPORT=nats: token of the NATS server.
NATS_TOKEN=
# REDIS_USERNAME (Redis ACL user) does not apply here: the bundled Redis only has its default user.

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# A refresh token that was just replaced keeps working this many seconds (two tabs, a retried request).
REFRESH_REUSE_LEEWAY_SECONDS=30

# n8n calls /api/automation/* with it (credential "Meliora automation API (x-api-key)").
AUTOMATION_API_KEY=
# Events sent to n8n: WEBHOOK_SECRET signs them (credential "Meliora webhook signature") and
# WEBHOOK_AUTH_TOKEN is their bearer token (credential "Meliora webhook (Authorization)", value
# "Bearer <WEBHOOK_AUTH_TOKEN>"). Two different values: n8n saves the bearer token with every execution.
WEBHOOK_SECRET=
WEBHOOK_AUTH_TOKEN=
# Encrypts the credentials saved in n8n: keep it, n8n cannot read them after a change.
N8N_ENCRYPTION_KEY=

ADMIN_EMAIL=admin@meliora-gym.tn
# First admin, created when no admin exists (at least 12 characters).
ADMIN_PASSWORD=

# Public origins of the website / admin (comma separated)
CORS_ORIGINS=http://localhost:8080
DB_SYNCHRONIZE=true

# ---- Exposure ----
# Browsers, the app and door agents use the web container (:8080): its nginx forwards /api, /docs,
# /socket.io and /agent-socket to the gateway. The gateway (4000) and the n8n editor (5678) only
# listen on the server itself; use 0.0.0.0 only behind a firewall or a TLS proxy.
GATEWAY_BIND=127.0.0.1
N8N_BIND=127.0.0.1
# Proxies whose X-Forwarded-For the gateway believes (client IP for rate limits): presets loopback,
# linklocal, uniquelocal, IPs or CIDRs (comma separated), a number of hops, or false. On a server
# inside the gym LAN, clients have private addresses too: use the number of proxies instead
# (1 = the web container's nginx, 2 = a TLS proxy in front of it). Same when clients reach port
# 8080 directly over IPv6: Docker relays them to nginx from a private address.
TRUST_PROXY=loopback, linklocal, uniquelocal

# n8n receives every customer event here (Webhook node, path "meliora-events")
N8N_WEBHOOK_URL=http://n8n:5678/webhook/meliora-events
N8N_PUBLIC_URL=http://localhost:5678/

# ---- Outbound calls ----
# Extra hosts automation tasks may call on private networks ("host" or "host:port", comma
# separated). The n8n host of N8N_WEBHOOK_URL is always allowed; other destinations must be public.
AUTOMATION_ALLOWED_HOSTS=
# Private networks (CIDR, comma separated) where door relays called by the server may be.
RELAY_ALLOWED_NETWORKS=10.0.0.0/8,192.168.0.0/16
# Public IP or CIDR of the gym Wi-Fi (comma separated): the app opens doors only from there.
# Empty = no network check.
APP_OPEN_ALLOWED_NETWORKS=

# Gym details to confirm with the owner
GYM_PHONE=+216 00 000 000
GYM_EMAIL=contact@meliora-gym.tn
GYM_LAT=35.8456
GYM_LNG=10.6178
GEOFENCE_METERS=150
GYM_OPENING_HOURS=Lun – Sam|06:00|22:00;Dimanche|08:00|14:00

# Door agent (profile "agent")
DOOR_AGENT_SERVER_URL=http://api-gateway:4000
DOOR_AGENT_KEY=
DOOR_AGENT_DEFAULT_DOOR_ID=
