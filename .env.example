# Variables for docker-compose.yml — copy to .env and change every secret.
# (Local development without Docker uses backend/.env instead.)

POSTGRES_USER=meliora
POSTGRES_PASSWORD=change-me-postgres

# openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
AUTOMATION_API_KEY=change-me-automation-key
WEBHOOK_SECRET=change-me-webhook-secret
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key

ADMIN_EMAIL=admin@meliora-gym.tn
ADMIN_PASSWORD=change-me-admin-password

# Public origins of the website / admin (comma separated)
CORS_ORIGINS=http://localhost:8080

# redis (default) or nats (+ `--profile nats`) for several replicas per service
BUS_TRANSPORT=redis
DB_SYNCHRONIZE=true

# n8n receives every customer event here (Webhook node, path "meliora-events")
N8N_WEBHOOK_URL=http://n8n:5678/webhook/meliora-events
N8N_PUBLIC_URL=http://localhost:5678/

# Gym details to confirm with the owner
GYM_PHONE=+216 00 000 000
GYM_EMAIL=contact@meliora-gym.tn
GYM_LAT=35.8456
GYM_LNG=10.6178
GEOFENCE_METERS=150
GYM_OPENING_HOURS=Lun – Sam|06:00|22:00;Dimanche|08:00|14:00

# Door agent (profile "agent")
DOOR_AGENT_SERVER_URL=http://api-gateway:4000
DOOR_AGENT_KEY=
DOOR_AGENT_DEFAULT_DOOR_ID=
