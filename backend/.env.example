# Local development values. With NODE_ENV=production the gateway and every service refuse to
# start with these example secrets or weak ones: generate each key and token with
#   openssl rand -hex 32
# (32 characters minimum; passwords 12) and never reuse a value for two variables.

# ---- Runtime ----
NODE_ENV=development
TZ=Africa/Tunis

# ---- Message bus (redis for dev, nats for production replicas) ----
BUS_TRANSPORT=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Empty for a local Redis without a password (Homebrew); docker-compose always sets one.
REDIS_PASSWORD=
# Optional Redis 6+ ACL user, authenticated with REDIS_PASSWORD
# REDIS_USERNAME=
# NATS_URL=nats://127.0.0.1:4222
# Token of a NATS server started with --auth
# NATS_TOKEN=

# ---- PostgreSQL (one database per service: meliora_auth, meliora_membership, ...) ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
# Dev only: let TypeORM create tables from entities. Use migrations in production.
DB_SYNCHRONIZE=true
DB_LOGGING=false
# Optional per-service override, e.g. ACCESS_DATABASE_URL=postgres://user:pass@host:5432/meliora_access

# ---- API gateway ----
GATEWAY_PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006
# Proxies whose X-Forwarded-For is believed (client IP for rate limits): presets loopback,
# linklocal, uniquelocal, IPs or CIDRs (comma separated), a number of hops, or false.
TRUST_PROXY=loopback, linklocal, uniquelocal
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
# A refresh token that was just replaced keeps working this many seconds (two tabs, a retried request)
REFRESH_REUSE_LEEWAY_SECONDS=30
# n8n calls /api/automation/* with header x-api-key
AUTOMATION_API_KEY=change-me-automation-key

# ---- Bootstrap admin (created by auth-service when no admin exists) ----
ADMIN_EMAIL=admin@meliora-gym.tn
ADMIN_PASSWORD=Meliora2026!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Meliora

# ---- Access service (door agents connect here through the gateway: /agent-socket) ----
ACCESS_WS_PORT=4004
GEOFENCE_METERS=150
# Private networks (CIDR, comma separated) where door relays called by the server may be
RELAY_ALLOWED_NETWORKS=10.0.0.0/8,192.168.0.0/16
# Public IP or CIDR of the gym Wi-Fi (comma separated): the app opens doors only from there.
# Empty = no network check.
APP_OPEN_ALLOWED_NETWORKS=

# ---- Notifications ----
# n8n "Webhook" node URL that receives every customer-facing event
N8N_WEBHOOK_URL=http://localhost:5678/webhook/meliora-events
# Signs every event: X-Meliora-Signature (n8n credential "Meliora webhook signature")
WEBHOOK_SECRET=change-me-webhook-signing-secret
# Bearer token of every event, a different value (n8n credential "Meliora webhook (Authorization)"
# = Bearer <WEBHOOK_AUTH_TOKEN>). Empty: WEBHOOK_SECRET is sent instead, outside production only.
WEBHOOK_AUTH_TOKEN=change-me-webhook-auth-token
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPIRY_REMINDER_DAYS=3

# ---- Workflow automations (workflow-service) ----
# Extra hosts AUTOMATION tasks may call on private networks ("host" or "host:port", comma
# separated). The n8n host of N8N_WEBHOOK_URL is always allowed; other destinations must be public.
AUTOMATION_ALLOWED_HOSTS=

# ---- Gym public info (confirm phone, hours and GPS point with the gym) ----
GYM_NAME=Meliora Gym
GYM_TAGLINE=Forge ta meilleure version
GYM_ADDRESS=Khzema Est, Rue Colonel Garnaoui
GYM_CITY=Sousse 4051, Tunisie
GYM_PHONE=+216 00 000 000
GYM_EMAIL=contact@meliora-gym.tn
GYM_INSTAGRAM=https://www.instagram.com/gymmeliora/
GYM_FACEBOOK=https://www.facebook.com/p/Meliora-Gym-61589769249533/
GYM_MAPS_URL=https://maps.app.goo.gl/CVWB98nx2RdSd8Mw8
GYM_LAT=35.8456
GYM_LNG=10.6178
GYM_OPENING_HOURS=Lun – Sam|06:00|22:00;Dimanche|08:00|14:00

# ---- Class reservations (class-service) ----
BOOKING_OPENS_DAYS=7
BOOKING_CLOSES_MINUTES=0
CANCEL_DEADLINE_HOURS=2
NO_SHOW_LIMIT=3
NO_SHOW_BLOCK_DAYS=7
CHECKIN_WINDOW_MINUTES=30
BOOKING_SWEEP_SECONDS=300
