{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/api-gateway",
  "sourceRoot": "apps/api-gateway/src",
  "compilerOptions": {
    "webpack": true,
    "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
  },
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json",
        "plugins": [
          {
            "name": "@nestjs/swagger",
            "options": {
              "classValidatorShim": true,
              "introspectComments": true
            }
          }
        ]
      }
    },
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json"
      }
    },
    "membership-service": {
      "type": "application",
      "root": "apps/membership-service",
      "entryFile": "main",
      "sourceRoot": "apps/membership-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/membership-service/tsconfig.app.json"
      }
    },
    "class-service": {
      "type": "application",
      "root": "apps/class-service",
      "entryFile": "main",
      "sourceRoot": "apps/class-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/class-service/tsconfig.app.json"
      }
    },
    "access-service": {
      "type": "application",
      "root": "apps/access-service",
      "entryFile": "main",
      "sourceRoot": "apps/access-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/access-service/tsconfig.app.json"
      }
    },
    "notification-service": {
      "type": "application",
      "root": "apps/notification-service",
      "entryFile": "main",
      "sourceRoot": "apps/notification-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification-service/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "staff-service": {
      "type": "application",
      "root": "apps/staff-service",
      "entryFile": "main",
      "sourceRoot": "apps/staff-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/staff-service/tsconfig.app.json"
      }
    },
    "facility-service": {
      "type": "application",
      "root": "apps/facility-service",
      "entryFile": "main",
      "sourceRoot": "apps/facility-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/facility-service/tsconfig.app.json"
      }
    },
    "commerce-service": {
      "type": "application",
      "root": "apps/commerce-service",
      "entryFile": "main",
      "sourceRoot": "apps/commerce-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/commerce-service/tsconfig.app.json"
      }
    },
    "training-service": {
      "type": "application",
      "root": "apps/training-service",
      "entryFile": "main",
      "sourceRoot": "apps/training-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/training-service/tsconfig.app.json"
      }
    },
    "workflow-service": {
      "type": "application",
      "root": "apps/workflow-service",
      "entryFile": "main",
      "sourceRoot": "apps/workflow-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/workflow-service/tsconfig.app.json"
      }
    }
  }
}