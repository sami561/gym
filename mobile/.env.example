# Base URL of the Meliora API (no trailing slash, without /api).
# Backend started with `npm start` on your computer (gateway on port 4000):
# - iOS simulator on the same Mac: http://localhost:4000
# - Android emulator: http://10.0.2.2:4000
# - Real phone with Expo Go: your computer's LAN IP, e.g. http://192.168.1.20:4000
# Backend in Docker or on a server: the web container, whose nginx forwards /api to the gateway
# (port 4000 of a server is not reachable), e.g. http://192.168.1.20:8080, or the HTTPS URL of a
# published server, e.g. https://sandbox.meliora-gym.tn
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
