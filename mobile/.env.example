# Base URL of the Meliora API gateway (no trailing slash, without /api).
# - iOS simulator on the same Mac: http://localhost:4000
# - Android emulator: http://10.0.2.2:4000
# - Real phone with Expo Go: your computer's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
