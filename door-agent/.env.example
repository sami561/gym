# Meliora door agent — copy to .env and fill in.

# Address of the Meliora website: the agent connects to <SERVER_URL>/agents over /agent-socket, which
# the web container's nginx forwards to the gateway. Use the public HTTPS URL (https://meliora-gym.tn)
# or, on the LAN, the web container (http://<server>:8080). In Docker deployments the gateway port 4000
# only listens on 127.0.0.1 of the server: http://<server>:4000 cannot be reached from the gym.
# Local development (backend started with npm start): http://localhost:4000
SERVER_URL=http://192.168.1.10:8080
# Key shown once when the agent is created in the admin (Accès → Agents → Nouvel agent)
AGENT_KEY=

# Door used for QR codes read on this PC (USB scanner) or posted to /scan without a doorId.
# Optional when the agent manages a single door.
DEFAULT_DOOR_ID=

# Local endpoint for network QR readers (ESP32 / Wiegand bridges). 0 or empty = disabled.
LOCAL_SCAN_PORT=8787
LOCAL_SCAN_HOST=0.0.0.0
# Readers must send it in the x-scan-token header (strongly recommended on a shared LAN).
# Generate it with: openssl rand -hex 32
LOCAL_SCAN_TOKEN=

# Read QR codes typed by a USB keyboard-wedge scanner on stdin (agent running in a terminal)
SCAN_STDIN=true

# Member list push to ZKTeco terminals (seconds) and heartbeat period
SYNC_INTERVAL_SECONDS=300
HEARTBEAT_SECONDS=30
# disable = keep the user (and fingerprints) on the terminal but block it; delete = remove it
INACTIVE_POLICY=disable

# ZKTeco connection. ZK_TIMEOUT_MS: 2000-60000, the agent refuses to start below 2000; a door's
# config.timeoutMs below 2000 is ignored with the warning "ignoring config.timeoutMs".
ZK_TIMEOUT_MS=5000
ZK_KEEPALIVE_SECONDS=60
ZK_UDP_INPORT=5200

# Pending terminal punches (kept while the server is unreachable) and, per ZKTeco door, the terminal
# users the agent manages (zkteco-users-<doorId>.json): keep this folder across restarts and updates.
# Default ./data. The Docker image uses its /data volume: leave DATA_DIR unset there.
# DATA_DIR=./data
EVENT_BUFFER_MAX=5000

# debug | info | warn | error — LOG_FORMAT auto = pretty in a terminal, JSON otherwise
LOG_LEVEL=info
LOG_FORMAT=auto

# Terminals report punches in local time: keep the agent in the gym's timezone
TZ=Africa/Tunis
