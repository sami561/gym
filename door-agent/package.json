{
  "name": "meliora-door-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Meliora Gym door agent: runs on the gym LAN, connects to the access-service and drives ZKTeco terminals / relays to open doors",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mock-server": "tsx scripts/mock-server.ts"
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "socket.io-client": "4.8.4",
    "zkteco-js": "1.7.2"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "socket.io": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
