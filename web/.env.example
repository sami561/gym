# Base URL of the API gateway. Leave empty in dev: Vite proxies /api and /socket.io to VITE_PROXY_TARGET.
VITE_API_URL=
# Where the dev server proxies /api and /socket.io (the NestJS api-gateway).
VITE_PROXY_TARGET=http://localhost:4000
# Store links for the member app (shown on the landing page once published).
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
