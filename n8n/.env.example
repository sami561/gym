# ---- n8n ----
# Long random string (openssl rand -hex 32). Keep it: it encrypts the saved credentials.
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
N8N_PROTOCOL=http
# Public URL of n8n (the backend posts to <WEBHOOK_URL>webhook/meliora-events)
WEBHOOK_URL=http://localhost:5678/

# ---- Meliora ----
# API gateway as seen from the n8n container
MELIORA_API_URL=http://host.docker.internal:4000
# Public URLs used in the e-mails (the logo must be reachable from the internet)
MELIORA_LOGO_URL=https://meliora-gym.tn/images/logo.jpg
MELIORA_WEBSITE_URL=https://meliora-gym.tn
MELIORA_APP_URL=https://meliora-gym.tn/app
MELIORA_ADMIN_URL=https://meliora-gym.tn/admin
MELIORA_MAPS_URL=https://maps.app.goo.gl/CVWB98nx2RdSd8Mw8
# Sender (must be allowed by your SMTP provider) and internal recipients
MELIORA_FROM_EMAIL=Meliora Gym <contact@meliora-gym.tn>
MELIORA_OWNER_EMAIL=
MELIORA_STAFF_EMAIL=
# Shown in e-mail footers and used for the WhatsApp / call buttons (international format)
MELIORA_GYM_PHONE=
MELIORA_WHATSAPP=
# Optional offers (leave empty to say nothing)
MELIORA_BIRTHDAY_OFFER=
MELIORA_WINBACK_OFFER=
MELIORA_COMEBACK_OFFER=Une séance de reprise offerte avec un coach, pour repartir sur de bonnes bases et à votre rythme.
# Motivation workflow: let Claude write one personal sentence per e-mail (needs the "Anthropic API" credential)
MELIORA_MOTIVATION_AI=false
MELIORA_CLAUDE_MODEL=claude-opus-5-5
